    {
      "id": "style:Baroque",
      "type": "style",
      "attrs": {
        "name": "Baroque",
        "desc": "通奏低音主导,对位严密,装饰音即兴,常用羽管键琴音色"
      }
    },
    {
      "id": "style:Classical",
      "type": "style",
      "attrs": {
        "name": "Classical",
        "desc": "清晰句法,主-属调对话,动机发展,力度对比鲜明"
      }
    },
    {
      "id": "style:Romantic",
      "type": "style",
      "attrs": {
        "name": "Romantic",
        "desc": "情感表达自由,和声色彩丰富,踏板讲究,织体复杂"
      }
    },
    {
      "id": "err:Baroque:ornament",
      "type": "error",
      "attrs": {
        "period": "Baroque",
        "name": "装饰音不规范",
        "desc": "巴洛克装饰音(trill/mordent)无固定时值,需依风格加装饰"
      }
    },
    {
      "id": "err:Baroque:voice",
      "type": "error",
      "attrs": {
        "period": "Baroque",
        "name": "声部独立差",
        "desc": "对位作品各声部须独立,常被压成单层旋律"
      }
    },
    {
      "id": "err:Classical:articulation",
      "type": "error",
      "attrs": {
        "period": "Classical",
        "name": "触键不清晰",
        "desc": "古典奏鸣曲要求颗粒触键(staccato/legato 严格)"
      }
    },
    {
      "id": "err:Classical:rhythm",
      "type": "error",
      "attrs": {
        "period": "Classical",
        "name": "节奏自由过度",
        "desc": "古典风格不应有太多 rubato,需稳定拍感"
      }
    },
    {
      "id": "err:Romantic:pedal",
      "type": "error",
      "attrs": {
        "period": "Romantic",
        "name": "踏板滥用",
        "desc": "浪漫作品踏板频繁,初学者常踩太长导致和声浑浊"
      }
    },
    {
      "id": "err:Romantic:dynamic",
      "type": "error",
