# CoPiano v4 Backend — Environment Variables Example
# ──────────────────────────────────────────────
# 复制: cp .env.example .env
# 不要提交 .env 到 git!
# ──────────────────────────────────────────────

# ── 应用 ──
ENV=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ── CORS ──
# 逗号分隔的允许来源 (本地开发 + 生产)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://copiano.com,https://app.copiano.com

# ── 数据库 (PostgreSQL 16) ──
DATABASE_URL=postgresql+asyncpg://copiano:CHANGE_ME@localhost:5432/copiano
DATABASE_URL_SYNC=postgresql://copiano:CHANGE_ME@localhost:5432/copiano

# ── 缓存 (Redis 7) ──
REDIS_URL=redis://localhost:6379/0

# ── 认证 (JWT) ──
# 生成: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── OAuth ──
# Apple Sign-In
APPLE_CLIENT_ID=com.copiano.web
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
APPLE_PRIVATE_KEY_PATH=./secrets/apple_auth_key.p8

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 微信
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ── LLM ──
# Qwen 7B 本地 (AutoDL GPU 或本地)
QWEN_API_URL=http://localhost:8080
QWEN_MODEL_NAME=Qwen2.5-7B-Instruct

# OpenAI 备用
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_MODEL=gpt-4o-mini

# ── 存储 (S3 / MinIO) ──
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_BUCKET=copiano-midi
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# MinIO (自建,本地开发)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME

# ── 监控 ──
SENTRY_DSN=
PROMETHEUS_PORT=9090

# ── 第三方服务 ──
# Stripe (支付)
STRIPE_API_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# SendGrid (邮件)
SENDGRID_API_KEY=
EMAIL_FROM=hello@copiano.com
