# CoPiano Web Environment Variables (example)
# Copy to .env.local and fill in real values

# Backend API (FastAPI on copiano.com/api)
NEXT_PUBLIC_API_BASE_URL=https://api.copiano.com
NEXT_PUBLIC_WS_BASE_URL=wss://api.copiano.com

# Web app specific
NEXT_PUBLIC_APP_URL=https://app.copiano.com
NEXT_PUBLIC_MARKETING_URL=https://copiano.com

# Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=

# Stripe (subscription billing)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Apple/Google/WeChat OAuth (forwarded to backend)
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_WECHAT_APP_ID=
