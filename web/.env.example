# CoPiano Web Environment Variables (example)
# Copy to .env.local and fill in real values

# Backend API (FastAPI on copiano.com/api)
NEXT_PUBLIC_API_BASE_URL=https://api.copiano.com
NEXT_PUBLIC_WS_BASE_URL=wss://api.copiano.com

# Web app specific
NEXT_PUBLIC_APP_URL=https://app.copiano.com
NEXT_PUBLIC_MARKETING_URL=https://copiano.com

# Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=

# Stripe (subscription billing)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Apple/Google/WeChat OAuth (forwarded to backend)
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_WECHAT_APP_ID=

# NextAuth v5 (server-side only, NEVER prefix with NEXT_PUBLIC_)
NEXTAUTH_URL=https://app.copiano.com
NEXTAUTH_SECRET=        # openssl rand -base64 32
AUTH_TRUST_HOST=true    # 允许自定义 host header (反向代理场景)

# Google OAuth (用于 NextAuth Google provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In (用于 NextAuth Apple provider)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=    # ES256 private key 派生 (参考 apple signin docs)
