# CoPiano Web Environment Variables (example)
# Copy to .env.local (dev) and .env.production (server) and fill in real values
#
# 设计原则:同一份 build,以下 host 都跑得通,不需 rebuild:
#   - http://localhost:3000 (dev)
#   - https://<random>.trycloudflare.com (Cloudflare Tunnel)
#   - https://yefzyj.top / https://app.yefzyj.top (custom domain)
#
# 所以:
#   - 同源链接 (login/signup/curriculum)  → 相对路径,见 lib/urls.ts
#   - 跨源 (API/WS/docs)                 → 必填 env,无 fallback
#   - 站点 URL (canonical/sitemap/OG)     → runtime 从 request headers 读
#   - 邮件                                → env,默认 hi@yefzyj.top

# ── 跨源:Backend API (FastAPI :8001) ──
# 必填,跟 Next.js 不同源。
#  dev:        http://localhost:8001
#  tunnel:     https://printable-skirt-tell-publishers.trycloudflare.com
#  production: https://api.yefzyj.top
NEXT_PUBLIC_API_BASE_URL=
# WebSocket (默认从 API 派生,http→ws / https→wss)
NEXT_PUBLIC_WS_BASE_URL=

# ── 跨源:Docs (FastAPI Swagger) ──
# 可选,未设置 → 相对路径 /docs (同源静态或代理)
NEXT_PUBLIC_DOCS_URL=

# ── 站点 URL (用于 build 阶段 fallback / OAuth callback) ──
# 可选,运行时 canonical/sitemap 从 request headers 自动读
NEXT_PUBLIC_SITE_URL=

# ── 邮件 ──
NEXT_PUBLIC_CONTACT_EMAIL=hi@yefzyj.top
NEXT_PUBLIC_PRESS_EMAIL=press@yefzyj.top

# ── Analytics ──
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Stripe (subscription billing) ──
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Apple/Google/WeChat OAuth (forwarded to backend) ──
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_WECHAT_APP_ID=

# ── NextAuth v5 (server-side only, NEVER prefix with NEXT_PUBLIC_) ──
# NEXTAUTH_URL: 留空 → NextAuth 用 request host (需 trustHost: true)
# 设置后会强制使用,适合固定域名的生产环境
NEXTAUTH_URL=
NEXTAUTH_SECRET=        # openssl rand -base64 32
AUTH_TRUST_HOST=true    # 允许自定义 host header (反向代理 / Cloudflare Tunnel)

# ── Google OAuth (NextAuth Google provider) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Apple Sign In (NextAuth Apple provider) ──
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=    # ES256 private key 派生
